# Local dev: copy to .env and fill in
# Fly.io: set via `fly secrets set DJANGO_SECRET_KEY=...`

DJANGO_SECRET_KEY=change-me-local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: set DJANGO_CSRF_TRUSTED_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000
# Or set FRONTEND_URL=https://your-vercel-app.vercel.app (single origin, appended automatically to both CORS and CSRF)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
# Production: set DJANGO_CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000
# Or set FRONTEND_URL=https://your-vercel-app.vercel.app (single origin, appended automatically)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DATABASE_URL=
SQLITE_DATABASE_PATH=

# Firebase Admin SDK — set these three (preferred over FIREBASE_SERVICE_ACCOUNT_PATH)
# Get them from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# FIREBASE_PRIVATE_KEY must be the full key including -----BEGIN PRIVATE KEY----- lines.
# If the value contains literal \n characters, they will be replaced with real newlines.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
# Legacy: path to a Firebase service account JSON file (fallback if the three env vars above are not set)
FIREBASE_SERVICE_ACCOUNT_PATH=
