# =============================================================================
# OpenELD — Environment variables (copy this file to .env and fill in)
# =============================================================================

# --- Backend API ---
# Local dev:    http://127.0.0.1:8000/api
# Production:   https://openeld-wdvy.onrender.com/api
REACT_APP_API_URL=http://127.0.0.1:8000/api

# --- Firebase (frontend) ---
# Get these from https://console.firebase.google.com/ -> Project Settings -> General -> Your apps -> Web
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
