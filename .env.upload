# =============================================================================
# OpenELD — Environment variables for platform dashboards
# =============================================================================
# Copy-paste the relevant sections into your Vercel / Render dashboard.
#
# Vercel (Frontend):  https://vercel.com/.../settings/environment-variables
# Render (Backend):   https://dashboard.render.com/.../env
# =============================================================================


# ----- Vercel (frontend) -----
# Paste each REACT_APP_* into Vercel dashboard as a separate variable.

REACT_APP_API_URL=https://openeld-wdvy.onrender.com/api
REACT_APP_FIREBASE_API_KEY=AIzaSyDSW_qDyoKKtXL-yKODkckzwDe-oGKe2ZM
REACT_APP_FIREBASE_AUTH_DOMAIN=openeld.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=openeld
REACT_APP_FIREBASE_STORAGE_BUCKET=openeld.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=208576408630
REACT_APP_FIREBASE_APP_ID=1:208576408630:web:2c7ba269aca07533f2fc97


# ----- Render (backend) -----
# Paste these into Render dashboard as individual env vars.

FRONTEND_URL=https://platform-openeld.vercel.app

DJANGO_SECRET_KEY=change-me-local
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,openeld-wdvy.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://platform-openeld.vercel.app,http://localhost:3000,http://127.0.0.1:3000
DJANGO_CORS_ALLOWED_ORIGINS=https://platform-openeld.vercel.app,http://localhost:3000,http://127.0.0.1:3000
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=3600

# Firebase Admin SDK — get from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Render auto-injects DATABASE_URL (Postgres) if you have a Postgres add-on.
# DATABASE_URL=
