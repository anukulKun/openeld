# =============================================================================
# OpenELD frontend (app/) — environment variables
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# REACT_APP_* values are inlined into the JS bundle at build time.
# =============================================================================

# --- Backend API -----------------------------------------------------------
# Base URL of the Django backend WITHOUT a trailing slash, e.g.
#   Local dev:    http://127.0.0.1:8000/api
#   Production:   https://api.your-domain.com/api
# This must match the backend's DJANGO_ALLOWED_HOSTS and CORS/CSRF origins.
REACT_APP_API_URL=http://127.0.0.1:8000/api

# --- Firebase (frontend, required for login) -------------------------------
# Get these from Firebase Console -> your Firebase project -> Project Settings
# -> General -> Your apps -> Web app config. Use YOUR OWN project's values.
# Leave them empty and the sign-in gate is disabled (app runs unauthenticated).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=