# =============================================================================
# OpenELD backend — environment variables
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# Every variable is optional except DJANGO_SECRET_KEY in production; the app
# boots with the defaults below for local development.
# =============================================================================

# --- Django core -----------------------------------------------------------
# Used to sign sessions, CSRF tokens, passwords, etc. MUST be a long random
# string in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-local

# Debug mode. Keep True for local dev, False in production (hides stack traces).
DJANGO_DEBUG=True

# Comma-separated hostnames your backend is served from. Add your real domain
# in production, e.g. api.example.com,my-app.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS / CSRF (frontend origins) ----------------------------------------
# Comma-separated origins that may call the API from the browser, e.g.
#   https://your-frontend.example.com,http://localhost:3000
# Set FRONTEND_URL (below) to a single origin and both CORS + CSRF pick it up
# automatically.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Comma-separated origins allowed to send state-changing (CSRF) requests.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Optional: a single frontend origin. If set, it is appended to both
# DJANGO_CORS_ALLOWED_ORIGINS and DJANGO_CSRF_TRUSTED_ORIGINS automatically.
# Production example: https://your-frontend.example.com
FRONTEND_URL=

# Whether the browser may send cookies with cross-origin API calls.
# Keep True (the app relies on bearer tokens; harmless if left default).
DJANGO_CORS_ALLOW_CREDENTIALS=True

# --- HTTPS hardening -------------------------------------------------------
# Force HTTPS redirect, mark cookies Secure, and set HSTS. Set all three to
# True in production behind TLS (Render, Vercel, nginx, etc. terminate TLS).
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# --- Database --------------------------------------------------------------
# Pick ONE:
#   1) Postgres (recommended for production) — a connection URL like:
#        postgres://user:password@host:5432/dbname
#      Render injects this automatically as DATABASE_URL if you add a Postgres
#      instance. Any provider that gives you a postgres:// URL works.
#   2) SQLite (default, fine for local dev) — leave DATABASE_URL empty and
#      optionally point SQLITE_DATABASE_PATH at a file. The Docker image uses
#      /app/backend/data/db.sqlite3 with a persistent volume.
DATABASE_URL=
SQLITE_DATABASE_PATH=

# --- Firebase Auth (optional but recommended) ------------------------------
# Three env vars from your OWN Firebase project:
#   Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# then paste:
#   - project_id   -> FIREBASE_PROJECT_ID
#   - client_email -> FIREBASE_CLIENT_EMAIL
#   - private_key  -> FIREBASE_PRIVATE_KEY (single line; literal \n characters
#     are converted to real newlines automatically)
# Leave all three empty and auth is disabled (the app runs unauthenticated).
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
# Legacy alternative: absolute path to a downloaded service-account JSON file.
# Only used if the three vars above are not set. Keep this empty unless you
# need it. NEVER commit the JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Routing / geocoding ---------------------------------------------------
# OpenELD uses free OSRM + OpenStreetMap Nominatim by default (no API key).
# To self-host (privacy / reliability / rate limits):
#   - OSRM: deploy your own server (https://github.com/Project-OSRM/osrm-backend)
#     and set OSRM_BASE_URL to e.g. http://your-osrm-host:5000/route/v1/driving
#   - Nominatim: set up your own instance (https://nominatim.org/) and set
#     NOMINATIM_BASE_URL to e.g. http://your-nominatim-host
OSRM_BASE_URL=http://router.project-osrm.org/route/v1/driving
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- Platform-injected (usually do NOT set these yourself) -----------------
# RENDER_EXTERNAL_HOSTNAME — added automatically by Render; included in
# ALLOWED_HOSTS / CORS / CSRF. FLY_APP_NAME — same for Fly.io.
